# 從 https://discord.com/developers/applications 取得
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# 選填：填入後 deploy-commands 只註冊到此 guild（開發用，即時生效）
DISCORD_GUILD_ID=

# 資料庫：本機與 Docker Compose 預設使用 SQLite
DATABASE_DRIVER=sqlite
# Render 免費方案沒有持久化磁碟，改用任何 libSQL 相容服務
# DATABASE_DRIVER=libsql
# DATABASE_URL=libsql://your-database.example.com
# DATABASE_AUTH_TOKEN=

# 選填：SQLite 資料目錄；Docker Compose 已固定掛載到 /app/data
# BOT_DATA_DIR=/app/data

# 選填：啟動 /healthz HTTP 端點；Render 會自動提供 PORT
# PORT=10000

# OpenAI 相容的 AI 服務；金鑰請只放在本機或雲端平台的 Secret
# 以下預設值使用 Groq，也可替換成其他相容服務的網址與模型
# AI_API_KEY=
# AI_MODEL=qwen/qwen3.8-27b
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_PROVIDER_NAME=groq
# AI_MIN_REQUEST_INTERVAL_MS=2100
# AI_MAX_OUTPUT_TOKENS=900

# 開啟頻道自動翻譯。啟用前也要在 Discord Developer Portal 的 Bot 頁面
# 打開 MESSAGE CONTENT INTENT；右鍵手動翻譯不需要此設定。
TRANSLATION_AUTO_ENABLED=false

# dr.大暴龍符文診斷：用 /rune-dr open 設定頻道，只有 @Bot 才回答。
# 問題與圖片會傳給 AI，遊戲資料透過 Wiki MCP 查詢。
# 未指定諮詢 AI 設定時，金鑰優先使用 AI_WIKI_KEY，再沿用 AI_API_KEY。
# 模型與 API 網址預設沿用上面的 AI_MODEL / AI_BASE_URL。
AI_WIKI_KEY=
CONSULTATION_ENABLED=false
CONSULTATION_MCP_URL=https://dino-mutant-wiki.vercel.app/mcp
CONSULTATION_COOLDOWN_SECONDS=60
CONSULTATION_USER_DAILY_LIMIT=10
CONSULTATION_BOT_DAILY_LIMIT=100
CONSULTATION_MAX_CONCURRENT=1
# 諮詢模型需要支援圖片與工具呼叫。
# CONSULTATION_AI_API_KEY=
# CONSULTATION_AI_MODEL=qwen/qwen3.8-27b
# CONSULTATION_AI_BASE_URL=https://api.groq.com/openai/v1
