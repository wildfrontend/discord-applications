{
  "name": "@dc/dev-panel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "public"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
